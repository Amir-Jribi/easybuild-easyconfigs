easyblock = 'MakeCp'

name = 'Multiwfn'
version = '3.8'

homepage = 'http://sobereva.com/multiwfn'
description = "Wavefunction analysis program"

toolchain = {'name': 'intel', 'version': '2024a'}

source_urls = ['http://sobereva.com/multiwfn/misc']
sources = ['%(name)s_%(version)s_src_Linux.zip']

builddependencies = []


dependencies = [
('Mesa', '24.1.3'),
('motif', '2.3.8'),
('X11', '20240607'),
]

# If you need to edit the Makefile:
# ifort is deprecated, ifx is the new replacement that Intel OneAPI is now using
# also flag -mkl is deprecated , and the suggestion is to use -qmkl
prebuildopts = "sed -i 's/ifort/ifx/g' Makefile && sed -i 's/-mkl/-qmkl/g' Makefile && "

buildopts = ""

files_to_copy = [
    (['Multiwfn'], 'bin'),
    (['Multiwfn_noGUI'], 'bin'),
]

sanity_check_paths = {
    'files': ['bin/Multiwfn','bin/Multiwfn_noGUI'],
    'dirs': [],
}

moduleclass = 'chem'
